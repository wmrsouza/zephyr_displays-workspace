#include <dt-bindings/spi/spi.h>

/ {
	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &display_320x240;
	};

	aliases {
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		write-only;
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		#address-cells = <1>;
		#size-cells = <0>;

		display_320x240: ili9341@0 {
			compatible = "ilitek,ili9341";
			status = "okay";
			reg = <0>;
			mipi-max-frequency = <DT_FREQ_M(25)>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			/*mipi-cpol;*/
			/*mipi-cpha;*/
			/*mipi-hold-cs;*/
			te-mode = "MIPI_DBI_TE_NO_EDGE";
			te-delay = <0>;
			duplex = <SPI_FULL_DUPLEX>;
			width = <320>;
			height = <240>;
			rotation = <90>;
			pixel-format = <0>;
			/*display-inversion;*/
		};
	};
};

&spim2_default {
	group1 {
		pinmux = <SPIM2_SCLK_GPIO1>;
	};
	group2 {
		pinmux = <SPIM2_MOSI_GPIO2>;
		output-low;
	};
};

&spi2 {
	status = "okay";

	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
};

